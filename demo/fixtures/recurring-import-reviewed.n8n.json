    {
      "id": "load-prior-quote",
      "name": "Load prior quote",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1740,
        680
      ],
      "parameters": {
        "jsCode": "const c=$('Config').first().json;return [{json:{id:c.resumeQuoteId,input_hash:c.resumeInputHash,retryRequested:true}}];"
      }
    },
    {
      "name": "Verify retry identity",
      "id": "verify-retry-identity",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2060,
        680
      ],
      "parameters": {
        "jsCode": "const c=$('Config').first().json; const hash=require('crypto').createHash('sha256').update(c.feedCsv,'utf8').digest('hex');if($json.input_hash!==hash)throw new Error('Retry bytes differ from the original quote. Review a new import.');return [{json:$json}];"
      }
    },
    {
      "name": "Use quote",
      "id": "use-quote",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2060,
        1200
      ],
      "parameters": {
        "jsCode": "return $input.all();"
      }
    },
    {
      "id": "correction-requested",
      "name": "Correction requested",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        100,
        1000
      ],
      "parameters": {
        "conditions": {
          "options": {
