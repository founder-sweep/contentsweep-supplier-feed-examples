          "combinator": "and"
        }
      }
    },
    {
      "id": "download-jsonl",
      "name": "Download JSONL",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        600,
        440
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').first().json.baseUrl + '/v1/feeds/jobs/' + $('Start job').first().json.id + '/output' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "normalizedFeed"
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "CONFIGURE_IN_N8N",
          "name": "ContentSweep X-API-Key"
        }
      }
    },
    {
      "id": "resume-requested",
      "name": "Resume requested",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        900,
        440
      ],
      "parameters": {
        "conditions": {
          "options": {
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $('Config').first().json.resumeQuoteId !== '' }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "load-prior-quote",
      "name": "Load prior quote",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        440
      ],
      "parameters": {
        "jsCode": "const c=$('Config').first().json;return [{json:{id:c.resumeQuoteId,input_hash:c.resumeInputHash,retryRequested:true}}];"
      }
    },
    {
      "name": "Verify retry identity",
      "id": "verify-retry-identity",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1500,
        440
      ],
      "parameters": {
        "jsCode": "const c=$('Config').first().json; const hash=require('crypto').createHash('sha256').update(c.feedCsv,'utf8').digest('hex');if(c.approvedByOperator!==true||!Number.isInteger(c.pollLimit)||c.pollLimit<1||c.pollLimit>25||c.idempotencyKey.startsWith('YOUR_'))throw new Error('Review retry approval and configuration.');if($json.input_hash!==hash)throw new Error('Retry bytes differ from the original quote. Review a new import.');return [{json:$json}];"
      }
    },
    {
      "name": "Use quote",
      "id": "use-quote",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        660
      ],
      "parameters": {
        "jsCode": "return $input.all();"
      }
    },
    {
      "id": "correction-requested",
      "name": "Correction requested",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        300,
        660
      ],
      "parameters": {
        "conditions": {
          "options": {
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $('Config').first().json.correctionReplay === true }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "original-rejected-job",
      "name": "Original rejected job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        600,
        660
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').first().json.baseUrl + '/v1/feeds/jobs/' + $('Config').first().json.originalJobId }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "CONFIGURE_IN_N8N",
          "name": "ContentSweep X-API-Key"
        }
      }
    },
    {
      "name": "Confirm corrected bytes",
      "id": "confirm-corrected-bytes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        660
      ],
      "parameters": {
        "jsCode": "const c=$('Config').first().json; const hash=require('crypto').createHash('sha256').update(c.feedCsv,'utf8').digest('hex');if($json.status!=='completed'||$json.verdict!=='rejected'||!$json.receipt||$json.receipt.input_hash===hash)throw new Error('Correction requires a completed rejection and genuinely changed bytes.');return [{json:{correctionReviewed:true}}];"
      }
    },
    {
      "name": "Review required",
      "id": "review-required",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        660
      ],
      "parameters": {
        "jsCode": "throw new Error('Stopped before downstream preview. Review approval, source drift, funding, rejection, failure or polling deadline. Preserve the original quote and key on uncertain retries.');"
      }
    },
    {
      "id": "accepted-receipt",
      "name": "Accepted receipt",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1500,
        660
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').first().json.baseUrl + '/v1/feeds/jobs/' + $('Start job').first().json.id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "CONFIGURE_IN_N8N",
          "name": "ContentSweep X-API-Key"
        }
      }
    },
    {
      "name": "Verified inventory preview",
      "id": "verified-inventory-preview",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        880
      ],
      "parameters": {
        "jsCode": "const bytes=await this.helpers.getBinaryDataBuffer(0,'normalizedFeed');\nconst receipt=$('Accepted receipt').first().json.receipt;\nconst hash=require('crypto').createHash('sha256').update(bytes).digest('hex');\nif(!receipt||receipt.verdict!=='passed'||hash!==receipt.output_hash)throw new Error('Output fingerprint verification failed.');\nconst rows=bytes.toString('utf8').trim().split('\\n').filter(Boolean).map(line=>JSON.parse(line));\nreturn [{json:{mode:'Preview only; no external inventory write',verifiedArtifactHash:hash,rowCount:rows.length,inventory:rows.map(row=>({sku:row.sku,price:row.price,currency:row.currency}))}}];"
      }
    },
    {
      "name": "Setup",
      "id": "notes-0",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -440
      ],
      "parameters": {
        "content": "## Recurring import setup\nRun the existing approved-import recipe first. Review field meanings, IDs, locale, currency, contract and exact profile hash. Put its profileId here; this workflow never approves mappings. Configure your organization X-API-Key, source bytes and a fresh stable key. Defaults are inactive and unapproved. Five trials; $20/10 evaluations or optional $99/month/100. Completed rejections consume one evaluation. No automatic top-up.",
        "width": 600,
        "height": 380
      }
    },
    {
      "name": "Review and corrections",
      "id": "notes-1",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        650,
        -440
      ],
      "parameters": {
        "content": "## Two safe paths\nRecurring: reuse the approved profile; structural drift stops before a job. Corrected replay: set correctionReplay=true and originalJobId to the completed rejection. Correct bytes require a new key/quote; identical bytes are refused. Source/schema changes need a newly reviewed profile, never an automatic remap. Blocks, failures, HTTP errors and warnings never become inventory writes.",
        "width": 600,
        "height": 380
      }
    },
    {
      "name": "Recovery",
      "id": "notes-2",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        1300,
        -440
      ],
      "parameters": {
        "content": "## Bounded recovery and handoff\nPolling is bounded by the configured retry budget (25 retry cycles by default, plus the first status read). For uncertain dispatch or timeout, retain the ORIGINAL Quote node id, input_hash and retry key. Set resumeQuoteId/resumeInputHash from that saved response and preserve exact bytes/key. Recovery does not upload or quote again: the server verifies the original authorization and returns the same job. Expired quotes or changed bytes need review. HTTP errors stop execution. Enable the runner crypto built-in. Accepted JSONL is checked against the receipt SHA256, then shown as a local inventory preview. The supplied data is owned synthetic data; there is no storefront write or external email.",
        "width": 600,
        "height": 380
      }
    }
  ],
