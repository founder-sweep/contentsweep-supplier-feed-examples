{
  "name": "Review recurring supplier imports and replay corrections with ContentSweep",
  "nodes": [
    {
      "id": "run-manually",
      "name": "Run manually",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "config",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        300,
        0
      ],
      "parameters": {
        "mode": "raw",
        "jsonOutput": "{\"baseUrl\": \"https://mcp.contentsweep.ai\", \"feedCsv\": \"product_code,product_name,unit_price,currency,available\\n000123,Desk lamp,\\\"19,90\\\",EUR,12\\n000124,Reading light,\\\"24,50\\\",EUR,8\\n\", \"targetSchema\": {\"type\": \"object\", \"additionalProperties\": false, \"properties\": {\"sku\": {\"type\": \"string\"}, \"title\": {\"type\": \"string\"}, \"price\": {\"type\": \"string\", \"format\": \"decimal\"}, \"currency\": {\"type\": \"string\", \"enum\": [\"EUR\"]}, \"stock\": {\"type\": \"integer\", \"minimum\": 0}}, \"required\": [\"sku\", \"title\", \"price\", \"currency\", \"stock\"]}, \"mapping\": [{\"source\": \"product_code\", \"target\": \"sku\", \"operation\": \"copy\"}, {\"source\": \"product_name\", \"target\": \"title\", \"operation\": \"copy\"}, {\"source\": \"unit_price\", \"target\": \"price\", \"operation\": \"decimal\", \"decimal_separator\": \",\"}, {\"source\": \"currency\", \"target\": \"currency\", \"operation\": \"copy\"}, {\"source\": \"available\", \"target\": \"stock\", \"operation\": \"integer\"}], \"contract\": {\"rules\": [{\"id\": \"unique-sku\", \"type\": \"unique\", \"column\": \"sku\"}]}, \"approvedByOperator\": false, \"profileId\": \"YOUR_APPROVED_PROFILE_ID\", \"originalJobId\": \"YOUR_REJECTED_JOB_ID\", \"idempotencyKey\": \"YOUR_UNIQUE_IMPORT_KEY\", \"correctionReplay\": false, \"resumeQuoteId\": \"\", \"resumeInputHash\": \"\", \"pollLimit\": 25}"
      }
    },
    {
      "id": "operator-approved",
      "name": "Operator approved",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        600,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $('Config').first().json.approvedByOperator === true && Number.isInteger($('Config').first().json.pollLimit) && $('Config').first().json.pollLimit >= 1 && $('Config').first().json.pollLimit <= 25 && !$('Config').first().json.profileId.startsWith('YOUR_') && !$('Config').first().json.idempotencyKey.startsWith('YOUR_') }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "upload",
      "name": "Upload",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.baseUrl + '/v1/feeds/uploads?format=csv' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "text/csv",
        "body": "={{ $('Config').first().json.feedCsv }}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "CONFIGURE_IN_N8N",
          "name": "ContentSweep X-API-Key"
        }
      }
    },
    {
      "id": "quote",
      "name": "Quote",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.baseUrl + '/v1/feeds/quotes' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {upload_id: $('Upload').first().json.id, profile_id: $('Config').first().json.profileId} }}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "CONFIGURE_IN_N8N",
          "name": "ContentSweep X-API-Key"
        }
      }
    },
    {
      "id": "compatible-source",
      "name": "Compatible source",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1500,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.retryRequested === true || ($json.status === 'quoted' && $json.funded === true) }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "start-job",
      "name": "Start job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        220
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.baseUrl + '/v1/feeds/jobs' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {quote_id: $('Use quote').first().json.id, idempotency_key: $('Config').first().json.idempotencyKey} }}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "CONFIGURE_IN_N8N",
          "name": "ContentSweep X-API-Key"
        }
      }
    },
    {
      "id": "wait",
      "name": "Wait",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        300,
        220
      ],
      "parameters": {
        "amount": 5,
        "unit": "seconds"
      }
    },
    {
      "id": "job-status",
      "name": "Job status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        600,
        220
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').first().json.baseUrl + '/v1/feeds/jobs/' + $('Start job').first().json.id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "CONFIGURE_IN_N8N",
          "name": "ContentSweep X-API-Key"
        }
      }
    },
    {
      "id": "terminal-job",
      "name": "Terminal job",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        900,
        220
      ],
      "parameters": {
        "conditions": {
          "options": {
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ ['completed','failed'].includes($json.status) }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "polling-budget",
      "name": "Polling budget",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1200,
        220
      ],
      "parameters": {
        "conditions": {
          "options": {
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $runIndex < $('Config').first().json.pollLimit }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "completed-evaluation",
      "name": "Completed evaluation",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1500,
        220
      ],
      "parameters": {
        "conditions": {
          "options": {
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.status === 'completed' }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "validation-report",
      "name": "Validation report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        440
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').first().json.baseUrl + '/v1/feeds/jobs/' + $('Start job').first().json.id + '/report' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "CONFIGURE_IN_N8N",
          "name": "ContentSweep X-API-Key"
        }
      }
    },
    {
      "id": "accepted-output",
      "name": "Accepted output",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        300,
        440
      ],
      "parameters": {
        "conditions": {
          "options": {
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.verdict === 'passed' }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
