{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "ai.contentsweep/supplier-feeds",
  "title": "ContentSweep Supplier Feeds",
  "description": "Map and validate recurring flat supplier catalogs with approved profiles and drift checks.",
  "version": "1.1.1",
  "websiteUrl": "https://mcp.contentsweep.ai/imports",
  "repository": {
    "url": "https://github.com/founder-sweep/contentsweep-supplier-feed-examples",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.contentsweep.ai/v1/feeds/mcp/",
      "headers": [
        {
          "name": "X-API-Key",
          "description": "Existing organization API key",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
